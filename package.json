{
  "name": "maison-noir",
  "version": "1.0.0",
  "description": "MAISON NOIR — Luxury Perfume Landing Page",
  "scripts": {
    "dev": "npx tailwindcss -i ./src/input.css -o ./dist/assets/styles.min.css --watch",
    "build:css": "npx tailwindcss -i ./src/input.css -o ./dist/assets/styles.min.css --minify",
    "build:js": "node scripts/build-js.js",
    "build": "npm run build:css && npm run build:js && node scripts/copy-html.js",
    "preview": "npx serve . -l 3000"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3"
  },
  "license": "MIT"
}
